{
  "id": "astron-agent-team",
  "name": "Agent Team",
  "description": "Dynamic multi-agent team orchestration with template-based provisioning.",
  "enabledByDefault": true,
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "team_plan",
      "team_provision",
      "team_execute",
      "team_complete",
      "team_update_progress",
      "team_cleanup"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "logs": {
        "type": "boolean",
        "default": false,
        "description": "Enable team-level diagnostic logging for artifact recognition."
      },
      "artifactLabel": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "timeoutMs": { "type": "integer", "minimum": 5000, "maximum": 300000 },
          "provider": { "type": "string" },
          "model": { "type": "string" }
        }
      }
    }
  }
}
